[Unit]
Description=Single persistent paper trader executor
Wants=network-online.target
After=network-online.target docker.service always-on-proxy.service
Requires=docker.service always-on-proxy.service
RequiresMountsFor=@TRADER_ROOT@ @TRADER_CONTROL@
ConditionPathExists=@TRADER_ROOT@/state/ledger.sqlite
ConditionPathExists=@TRADER_ROOT@/.env

[Service]
EnvironmentFile=/etc/always-on.env
ExecStart=/usr/bin/docker run --rm --name trader-executor --init --network host --user 501:501 --read-only --cap-drop ALL --security-opt no-new-privileges --log-opt max-size=10m --log-opt max-file=3 --pids-limit 128 --memory 2g --cpus 2 --tmpfs /tmp:mode=1777 --env HOME=@TRADER_HOME@ --workdir @TRADER_ROOT@ --mount type=bind,src=/run/trader-cloudsql,dst=/run/trader-cloudsql,readonly --mount type=bind,src=@TRADER_ROOT@/state,dst=@TRADER_ROOT@/state --mount type=bind,src=@TRADER_CONTROL@,dst=@TRADER_CONTROL@ --mount type=bind,src=@TRADER_ROOT@/config.toml,dst=/run/config.toml,readonly --mount type=bind,src=@TRADER_ROOT@/.env,dst=/run/secrets/trader_env,readonly ${TRADER_IMAGE} listen
ExecStop=/usr/bin/docker stop --time 45 trader-executor
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
