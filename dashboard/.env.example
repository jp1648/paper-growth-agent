# Server-only, SELECT-only database login. Use a hosted database for Vercel.
DATABASE_URL=postgresql://dashboard_reader:password@127.0.0.1:55432/observability
# Generate a long random password; required in every environment.
DASHBOARD_PASSWORD=
# Verify the hosted database's TLS certificate; never disable verification.
DATABASE_SSL=false

# Supabase root certificate PEM when needed for verified TLS (server-only).
DATABASE_SSL_CA=
